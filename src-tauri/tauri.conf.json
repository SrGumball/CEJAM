{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CEJAM",
  "version": "1.0.0",
  "identifier": "br.org.cejam.sistema",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "CEJAM — Sistema Hospitalar",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
